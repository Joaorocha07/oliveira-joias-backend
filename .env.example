PORT=3001

# Mesmo projeto Supabase usado pelo oliveira-joias-frontend.
# Use a SERVICE ROLE key aqui (não a anon key) — este backend roda
# só no servidor e precisa ignorar RLS para inserir produtos.
SUPABASE_URL=https://ifpcohlidgadciluzvhw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Domínio público do bucket (ex: https://pub-xxxxxxxx.r2.dev ou domínio customizado)
R2_PUBLIC_URL=

# WhatsApp — segredo compartilhado entre backend e frontend para proteger as rotas
# Gere qualquer string aleatória longa (ex: openssl rand -hex 32)
WHATSAPP_SECRET=
